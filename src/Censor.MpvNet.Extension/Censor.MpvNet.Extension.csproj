<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CensorExtension</AssemblyName>
    <RootNamespace>Censor.MpvNet.Extension</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Single-DLL packaging intentionally compiles Core sources again under the
      WinForms target. Keep Core type names independent of WinForms implicit
      types such as Timer, Label, Screen, and Padding; CI builds both the
      standalone Core project and this linked copy to catch those collisions.
    -->
    <Compile
      Include="..\Censor.Core\**\*.cs"
      Exclude="..\Censor.Core\bin\**\*;..\Censor.Core\obj\**\*"
      Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="libmpvnet">
      <HintPath>..\..\.deps\mpvnet\libmpvnet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
